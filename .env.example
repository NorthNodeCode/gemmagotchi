# Which Gemma 4 provider to use.
#   auto   — try local Ollama first, fall back to the hosted Gemini API (default)
#   local  — only Ollama (gemma4:e4b). No network, no key, no rate limit.
#   hosted — only the Gemini API (gemma-4-26b-a4b-it). Needs GEMINI_API_KEY.
GEMMA_PROVIDER=auto

# Only needed for the hosted path. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override if Ollama is not on the default port.
# OLLAMA_BASE_URL=http://localhost:11434
